                                #>
                                _add = (BiOperator<T>)(object)(BiOperator<<#=dec#>>)( (a,b)=>
                                {
                                    try
                                    {
                                        return a + b;
                                    }
                                    catch(OverflowException)
                                    {
                                        if(MathX.Abs(a.Ticks) > MathX.Abs(b.Ticks))
                                            return a.Ticks > 0 ? TimeSpan.MaxValue : TimeSpan.MinValue;
                                        else
                                            return b.Ticks > 0 ? TimeSpan.MaxValue : TimeSpan.MinValue;
                                    }
                                });

                                _sub = (BiOperator<T>)(object)(BiOperator<<#=dec#>>)( (a,b)=>
                                {
                                    try
                                    {
                                        return a - b;
                                    }
                                    catch(OverflowException)
                                    {
                                        if(MathX.Abs(a.Ticks) > MathX.Abs(b.Ticks))
                                            return a.Ticks > 0 ? TimeSpan.MaxValue : TimeSpan.MinValue;
                                        else
                                            return b.Ticks > 0 ? TimeSpan.MinValue : TimeSpan.MaxValue;
                                    }
                                });

                                _neg = (UniOperator<T>)(object)(UniOperator<<#=dec#>>)( a=> (<#=dec#>)(-a) );
								_abs = (UniOperator<T>)(object)(UniOperator<<#=dec#>>)( a=> MathX.Abs(a) );

                                <#
                            }
                            #>

							<#if(!dec.Contains("DateTime") && !dec.Contains("TimeSpan"))
							{
								#>
								_mul = (BiOperator<T>)(object)(BiOperator<<#=dec#>>)( (a,b)=> (<#=dec#>)(a*b) );

                                <#if((dec.Contains("float") || dec.Contains("double") || dec.Contains("color")) && dec != "color32")
                                {
                                    #>
                                    _validCheck = (BoolOperator<T>)(object)(BoolOperator<<#=dec#>>)( (v)=> MathX.IsValid(v) );
                                    _invalidFilter = (BiOperator<T>)(object)(BiOperator<<#=dec#>>)( (a,b)=> MathX.FilterInvalid(a, b) );
                                    <#
                                }
                                else
                                {
                                    #>
                                    _validCheck = (v) => true;
                                    _invalidFilter = (BiOperator<T>)(object)(BiOperator<<#=dec#>>)( (a,b)=> a);
                                    <#
                                }
                                #>

								<#if(dec.Contains("Q"))
								{
									#>
									Measurer<<#=dec#>> <#=name#>Distance = (a,b)=>(float)MathX.AngleRad(a,b);
									_distance = (Measurer<T>)(object)<#=name#>Distance;
									<#
								}
								else if(!type.IsMatrix && dec != "color32")
								{
									#>
									Measurer<<#=dec#>> <#=name#>Distance = (a,b)=>(float)MathX.Distance(a,b);
									_distance = (Measurer<T>)(object)<#=name#>Distance;
									<#
								}#>

								<#if((dec.Contains("float") || dec.Contains("double") || dec.Contains("color")) && dec != "color32")
								{
								#>
									_approximately = (Equaler<T>)(object)(Equaler<<#=dec#>>)( (a,b)=> MathX.Approximately(a,b) );

									SmoothLerper<<#=dec#>> <#=name#>SmoothLerp = delegate(<#=dec#> current, <#=dec#> target, ref <#=dec#> intermediate, float delta)
									{ return <#=smoothLerpFunc#>(current, target, ref intermediate, delta); };

									_smoothLerper = (SmoothLerper<T>)(object)<#=name#>SmoothLerp;

                                    ConstantLerper<<#=dec#>> <#=name#>ConstantLerp = delegate(<#=dec#> current, <#=dec#> target, float delta)
									{ return <#=constLerpFunc#>(current, target, delta); };

									_constantLerper = (ConstantLerper<T>)(object)<#=name#>ConstantLerp;

									<#if(!dec.Contains("Q"))
									{
										#>
										_round = (UniOperator<T>)(object)(UniOperator<<#=dec#>>)( v => MathX.Round(v) );
										<#
									}
									#>									
								<#
								}
								else
