				#>

				default:
                    
					if(typeof(T) == typeof(dummy) || (typeof(T).IsGenericType && typeof(T).GetGenericTypeDefinition() == typeof(dummy<>)))
					{
						_equaler = (a,b) => true;

						_encoder = (v,bw) => {};
						_decoder = (br) => default;

						_saver = v => new DataTreeValue(null as string);
						_loader = n => default;
					}
					else if(typeof(T).IsEnum)
					{
						_equaler = (a,b) => EqualityComparer<T>.Default.Equals(a, b);

						_encoder = (v,bw) => bw.WriteEnumBinary(v);
						_decoder = (br) => br.ReadEnumBinary<T>();

						_saver = v => DataTreeValue.FromEnum(v);
						_loader = n => ((DataTreeValue)n).ExtractEnum<T>();

						_strEncoder = v => Enums.AsString(typeof(T), v);
						_strDecoder = str => (T)Enum.Parse(typeof(T), str);
					}
					else if(typeof(T) == typeof(Rect))
					{
						Equaler<Rect> rectEq = (a,b) => a == b;

						Encoder<Rect> rectEnc = (v, bw) => bw.Write(v);
						Decoder<Rect> rectDec = br => br.ReadRect();

						Saver<Rect> rectSave = v => v.Save();
						Loader<Rect> rectLoad = n => n.LoadRect();

						StringEncoder<Rect> rectStrEnc = v => ((float4)v).ToString();
						StringDecoder<Rect> rectStrDec = str => (Rect)float4.Parse(str);

						_equaler = (Equaler<T>)(object)rectEq;

						_encoder = (Encoder<T>)(object)rectEnc;
						_decoder = (Decoder<T>)(object)rectDec;

                        _lerper = (Lerper<T>)(object)(Lerper<Rect>)( (a, b, lerp) => Rect.Lerp(a, b, lerp));
                        _lerperUnclamped = (Lerper<T>)(object)(Lerper<Rect>)( (a, b, lerp) => Rect.LerpUnclamped(a, b, lerp));

						_saver = (Saver<T>)(object)rectSave;
						_loader = (Loader<T>)(object)rectLoad;

						_strEncoder = (StringEncoder<T>)(object)rectStrEnc;
						_strDecoder = (StringDecoder<T>)(object)rectStrDec;
					}
                    else if(typeof(T) == typeof(half))
					{
						Equaler<half> halfEq = (a,b) => a == b;

						Encoder<half> halfEnc = (v, bw) => bw.Write(v);
