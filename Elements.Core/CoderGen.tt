						}#>							

                        _tryParser = (TryParser<T>)(object)(TryParser<<#=dec#>>)RobustParser.TryParse;

						<#if(type.Dimensions == 1)
						{
							#>
                            <#if(dec != "bool" && dec != "string")
                            {
                                #>
                                _comparer = (Comparer<T>)(object)(Comparer<<#=dec#>>)((a,b)=> a.CompareTo(b));

                                _lessThan = (BiBoolOperator<T>)(object)(BiBoolOperator<<#=dec#>>)((a,b) => a < b);
                                _lessThanOrEqual = (BiBoolOperator<T>)(object)(BiBoolOperator<<#=dec#>>)((a,b) => a <= b);
                                _greaterThan = (BiBoolOperator<T>)(object)(BiBoolOperator<<#=dec#>>)((a,b) => a > b);
                                _greaterThanOrEqual = (BiBoolOperator<T>)(object)(BiBoolOperator<<#=dec#>>)((a,b) => a >= b);
                                <#
                            }
                            else if(dec == "bool")
                            {
                                #>
                                _comparer = (Comparer<T>)(object)(Comparer<<#=dec#>>)((a,b)=> a.CompareTo(b));

                                _lessThan = (BiBoolOperator<T>)(object)(BiBoolOperator<<#=dec#>>)((a,b) => a.CompareTo(b) < 0);
                                _lessThanOrEqual = (BiBoolOperator<T>)(object)(BiBoolOperator<<#=dec#>>)((a,b) => a.CompareTo(b) <= 0);
                                _greaterThan = (BiBoolOperator<T>)(object)(BiBoolOperator<<#=dec#>>)((a,b) => a.CompareTo(b) > 0);
                                _greaterThanOrEqual = (BiBoolOperator<T>)(object)(BiBoolOperator<<#=dec#>>)((a,b) => a.CompareTo(b) >= 0);
                                <#
                            }
                            else if(dec == "string")
                            {
                                #>
                                _comparer = (Comparer<T>)(object)(Comparer<<#=dec#>>)((a,b)=> string.Compare(a, b));

                                _lessThan = (BiBoolOperator<T>)(object)(BiBoolOperator<<#=dec#>>)((a,b) => string.Compare(a, b) < 0);
                                _lessThanOrEqual = (BiBoolOperator<T>)(object)(BiBoolOperator<<#=dec#>>)((a,b) => string.Compare(a, b) <= 0);
                                _greaterThan = (BiBoolOperator<T>)(object)(BiBoolOperator<<#=dec#>>)((a,b) => string.Compare(a, b) > 0);
                                _greaterThanOrEqual = (BiBoolOperator<T>)(object)(BiBoolOperator<<#=dec#>>)((a,b) => string.Compare(a, b) >= 0);
                                <#
                            }#>

							<#
						}
						#>
						

						<#if(dec == "string")
						{
							#>Equaler<string> StringEq = (a,b) => a == b;<#
						}
						else
						{
							#>Equaler<<#=dec#>> <#=name#>Eq = (a,b) => a.Equals(b);<#
						}
						#>

