                        // This is very cursed. Once we're on .NET 9 we can switch away from this
                        var __min = (BiOperator<IQuantity>)( (a,b)=> (IQuantity)constructor.Invoke(new object[] { MathX.Min(a.BaseValue,b.BaseValue) } ));
						var __max = (BiOperator<IQuantity>)( (a,b)=> (IQuantity)constructor.Invoke(new object[] { MathX.Max(a.BaseValue,b.BaseValue) } ));

                        _min = (a,b) => (T)__min((IQuantity)a, (IQuantity)b);
                        _max = (a,b) => (T)__max((IQuantity)a, (IQuantity)b);

                        var __lerper = (Lerper<IQuantity>)( (a,b, lerp)=> (IQuantity)constructor.Invoke(new object[] { MathX.Lerp(a.BaseValue,b.BaseValue, lerp) } ));
                        var __lerperUnclamped = (Lerper<IQuantity>)( (a,b, lerp)=> (IQuantity)constructor.Invoke(new object[] { MathX.LerpUnclamped(a.BaseValue,b.BaseValue, lerp) } ));

                        _lerper = (a,b, lerp) => (T)__lerper((IQuantity)a, (IQuantity)b, lerp);
                        _lerperUnclamped = (a,b, lerp) => (T)__lerperUnclamped((IQuantity)a, (IQuantity)b, lerp);

                        var __add = (BiOperator<IQuantity>)( (a,b)=> (IQuantity)constructor.Invoke(new object[] { a.BaseValue + b.BaseValue } ));
                        var __sub = (BiOperator<IQuantity>)( (a,b)=> (IQuantity)constructor.Invoke(new object[] { a.BaseValue - b.BaseValue } ));
                        var __mul = (BiOperator<IQuantity>)( (a,b)=> (IQuantity)constructor.Invoke(new object[] { a.BaseValue * b.BaseValue } ));
                        var __div = (BiOperator<IQuantity>)( (a,b)=> (IQuantity)constructor.Invoke(new object[] { a.BaseValue / b.BaseValue } ));

                        _add = (a,b) => (T)__add((IQuantity)a, (IQuantity)b);
                        _sub = (a,b) => (T)__sub((IQuantity)a, (IQuantity)b);
                        _mul = (a,b) => (T)__mul((IQuantity)a, (IQuantity)b);
                        _div = (a,b) => (T)__div((IQuantity)a, (IQuantity)b);

                        _canDivide = (dividend, divisor) => true;
                        _canDivideBy = (divisor) => true;

                        var __scale = (FloatOperator<IQuantity>)( (a,scale)=> (IQuantity)constructor.Invoke(new object[] { a.BaseValue * scale } ));

                        _scale = (a,scale) => (T)__scale((IQuantity)a, scale);

                        var __neg = (UniOperator<IQuantity>)( (a)=> (IQuantity)constructor.Invoke(new object[] { -a.BaseValue } ));
                        var __abs = (UniOperator<IQuantity>)( (a)=> (IQuantity)constructor.Invoke(new object[] { MathX.Abs(a.BaseValue) } ));

                        _neg = (a) => (T)__neg((IQuantity)a);
                        _abs = (a) => (T)__abs((IQuantity)a);

                        MinValue = (T)constructor.Invoke(new object[] { double.MinValue });
						MaxValue = (T)constructor.Invoke(new object[] { double.MaxValue });

						_strEncoder = v => Coder<double>.EncodeToString(((IQuantity)v).BaseValue);
