							<#
						}
						#>

						<#if(dec != "string" && dec != "char" && !dec.Contains("bool")
                            && !(type.Dimensions > 1 && (dec.Contains("byte") || dec.Contains("short"))) )
						{
							string lerpFunc = "MathX.Lerp";
							string smoothLerpFunc = "MathX.SmoothLerp";
							string smooth = "MathX.SmoothLerp";
                            string constLerpFunc = "MathX.ConstantLerp";

							// use spherical interpolation for quaternions by default
							if(dec == "floatQ" || dec == "doubleQ")
							{
