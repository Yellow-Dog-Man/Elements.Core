<#@ template debug="false" hostspecific="false" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="netstandard" #>
<#@ assembly name="$(SolutionDir)CodeGenerationConfig\bin\$(ConfigurationName)\netstandard2.0\CodeGenerationConfig.dll" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenerationConfig" #>
<#@ output extension=".cs" #>
// Autogenerated!!! DO NOT MODIFY!
// Generated on: <#= DateTime.Now #>

using System;
using System.Collections.Generic;
using System.Globalization;
using EnumsNET;
using Elements.Quantity;
using Renderite.Shared;

namespace Elements.Core
{
    public static partial class Coder
    {
        static HashSet<Type> _baseEnginePrimitives = new HashSet<Type>()
        {
            <#
            for(int i = 0; i < Config.AllSupportedTypes.Count; i++)
            {
                var type = Config.AllSupportedTypes[i];

                #>typeof(<#=type.TypeDeclaration#>),
                <#
            }
            #>
            typeof(RefID),
            typeof(half), // Make this into actual primitive?
            typeof(Rect),
            typeof(BoundingBox),
            typeof(dummy),
            typeof(dummy<>),
        };
    }

	public static partial class Coder<T>
	{
		// initialization
		static Coder()
		{
			IsSupported = true;

			switch(typeof(T).Name)
			{
				<#
				foreach(var type in Config.AllSupportedTypes)
				{
					var name = type.TypeName;
					var dec = type.TypeDeclaration;

