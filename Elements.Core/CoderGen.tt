						{
							if(string.IsNullOrWhiteSpace(str))
								return null;
							else if(Uri.TryCreate(str, UriKind.Absolute, out var uri))
								return uri;
							else if(Uri.TryCreate(str, UriKind.Relative, out uri))
								return uri;
							else
