                            }

                            _equaler = (a,b) => EqualityComparer<T>.Default.Equals(a, b);

                            _add = (a, b) => ((IAddable<T>)a).Add(b);
                            _sub = (a, b) => ((ISubtractable<T>)a).Sub(b);
                            _scale = (a, n) => ((IScalable<T>)a).Scale(n);
                            _lerper = (a, b, lerp) => ((ILerpable<T>)a).Lerp(b, lerp);
                            _lerperUnclamped = (a, b, lerp) => ((ILerpable<T>)a).LerpUnclamped(b, lerp);
                            _constantLerper = (a, b, delta) => ((ILerpable<T>)a).ConstantLerp(b, delta);
                            _smoothLerper = delegate (T a, T b, ref T i, float delta) { return ((ILerpable<T>)a).SmoothLerp(b, ref i, delta); };

                            _validCheck = v => ((ISphericalHarmonics)v).IsValid;
                            _invalidFilter = (BiOperator<T>)typeof(SphericalHarmonicsHelper)
                                .GetMethod("FilterInvalid").MakeGenericMethod(typeof(T)).CreateDelegate(typeof(BiOperator<T>));

                            _encoder = (v,bw) => ((IEncodable)v).Encode(bw);
						    _decoder = (br) => 
						    {
							    // TODO!!! Add struct check?
                                IEncodable enc = (IEncodable)default(T);
                                enc.Decode(br);
							    return (T)enc;
						    };

						    _saver = v => ((IEncodable)v).Save();
						    _loader = n => 
						    {
							    IEncodable enc = (IEncodable)default(T);
							    enc.Load(n);
							    return (T)enc;
						    };

						    // doesn't support string encoding/decoding
						    _strEncoder = null;
						    _strDecoder = null;
                        }
                        <#
                    }
                    #>
					else if(typeof(IEncodable).IsAssignableFrom(typeof(T)))
					{
						// TODO!!! Create a variant which checks for static methods and assigns those directly
						// That would avoid a lot of casting and boxing

						_equaler = (a,b) => a.Equals(b);

						_encoder = (v,bw) => ((IEncodable)v).Encode(bw);
						_decoder = (br) => 
						{
							// TODO!!! Add struct check?
                            IEncodable enc = (IEncodable)default(T);
                            enc.Decode(br);
