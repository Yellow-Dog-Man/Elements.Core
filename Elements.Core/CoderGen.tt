						_encoder = (Encoder<T>)(object)CoderNullable.GetNullableMethod(typeof(T), typeof(Encoder<T>), "EncodeNullable");
						_decoder = (Decoder<T>)(object)CoderNullable.GetNullableMethod(typeof(T), typeof(Decoder<T>), "DecodeNullable");

						_saver = (Saver<T>)(object)CoderNullable.GetNullableMethod(typeof(T), typeof(Saver<T>), "SaveNullable");
						_loader = (Loader<T>)(object)CoderNullable.GetNullableMethod(typeof(T), typeof(Loader<T>), "LoadNullable");

						_strEncoder = (StringEncoder<T>)(object)CoderNullable.GetNullableMethod(typeof(T), typeof(StringEncoder<T>), "EncodeToStringNullable");
						_strDecoder = (StringDecoder<T>)(object)CoderNullable.GetNullableMethod(typeof(T), typeof(StringDecoder<T>), "DecodeFromStringNullable");
					}
