						};

						Decoder<<#=dec#>> <#=name#>Dec = (br) =>
						{
							<#if(dec == "string")
							{
								#>
								bool isNull = !br.ReadBoolean();
								return isNull ? null : br.ReadString();
								<#
							}
							else if(dec == "char")
							{
