								{
									#>
									_shift = (FloatOperator<T>)(object)(FloatOperator<<#=dec#>>)( (t,n)=> (<#=dec#>)(t+<#=floatOpCast#>n) );

									_div = (BiOperator<T>)(object)(BiOperator<<#=dec#>>)( (a,b)=> (<#=dec#>)(a/b) );
									_mod = (BiOperator<T>)(object)(BiOperator<<#=dec#>>)( (a,b)=> (<#=dec#>)(a%b) );

                                    <#
                                    if((dec.Contains("float") || dec.Contains("double") || dec.Contains("color") || dec.Contains("decimal"))
                                        && dec != "color32")
                                    {
                                        #>
                                        _canDivide = (BiBoolOperator<T>)(object)(BiBoolOperator<<#=dec#>>)( (dividend, divisor) => true);
                                        _canDivideBy = (BoolOperator<T>)(object)(BoolOperator<<#=dec#>>)( (divisor) => true);
                                        <#
                                    }
                                    else
                                    {
                                        #>
                                        _canDivide = (BiBoolOperator<T>)(object)(BiBoolOperator<<#=dec#>>)( (dividend, divisor)=> MathX.CanDivide(dividend, divisor) );
                                        _canDivideBy = (BoolOperator<T>)(object)(BoolOperator<<#=dec#>>)( (divisor) => MathX.CanDivideBy(divisor));
                                        <#
                                    }
                                    #>

									_repeat = (BiOperator<T>)(object)(BiOperator<<#=dec#>>)( (a,b)=> (<#=dec#>)MathX.Repeat(a,b) );

									_min = (BiOperator<T>)(object)(BiOperator<<#=dec#>>)( (a,b)=> (<#=dec#>)MathX.Min(a,b) );
									_max = (BiOperator<T>)(object)(BiOperator<<#=dec#>>)( (a,b)=> (<#=dec#>)MathX.Max(a,b) );
									_clamp = (TriOperator<T>)(object)(TriOperator<<#=dec#>>)( (n,min,max)=> (<#=dec#>)MathX.Clamp(n,min,max) );

