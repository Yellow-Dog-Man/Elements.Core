                                _add = (BiOperator<T>)(object)(BiOperator<<#=dec#>>)( (a,b)=> (<#=dec#>)(a+b) );
								_sub = (BiOperator<T>)(object)(BiOperator<<#=dec#>>)( (a,b)=> (<#=dec#>)(a-b) );

