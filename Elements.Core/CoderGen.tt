									<#
								}

								// Quantized encoding/decoding
								if(!type.IsMatrix && !dec.Contains("decimal") && dec != "colorX" && dec != "color32")
								{
									#>
									
									_qEncoder = (QuantizedEncoder<T>)(object)(QuantizedEncoder<<#=dec#>>)((value, min, max, bits, bw) =>
									{
										<#if(dec.Contains("Q"))
										{
											#>
											var q = MathX.QuantizeQuaternion(value, bits);
											bw.WriteBits(q.x, bits);
											bw.WriteBits(q.y, bits);
											bw.WriteBits(q.z, bits);
											bw.WriteBits(q.w, 3); // the 4th one encodes the sign and  the largest component

											<#if(dec.Contains("double")) { #>
												return MathX.DequantizeQuaternionDouble(q, bits); <# }
											else { #>
												return MathX.DequantizeQuaternion(q, bits); <# } #>

											<#
										}
										else
										{
											#>
											var q = MathX.Quantize(value, min, max, bits);
