						_decoder = (Decoder<T>)(object)boundsDec;

						_saver = (Saver<T>)(object)boundsSave;
						_loader = (Loader<T>)(object)boundsLoad;
					}
					else if(typeof(T) == typeof(Uri))
					{
						Equaler<Uri> uriEq = (a,b) => a == b;

						Encoder<Uri> uriEnc = (v, bw) => bw.Write(v);

						Decoder<Uri> uriDec = (br) => br.ReadUri();

						Saver<Uri> uriSave = v => new DataTreeValue(v);
						Loader<Uri> uriLoad = n => ((DataTreeValue)n).Extract<Uri>();

						StringEncoder<Uri> uriStrEnc = v => v?.ToString();
