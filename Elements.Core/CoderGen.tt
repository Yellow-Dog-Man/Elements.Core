                    <#for(int order = 1; order <= 4; order++)
                    {
                        #>
                        else if(typeof(T).IsGenericType && typeof(T).GetGenericTypeDefinition() == typeof(SphericalHarmonicsL<#=order#><>))
                        {
                            var arg = typeof(T).GetGenericArguments()[0];

                            unsafe
                            {
                                if(!Coder.IsEnginePrimitive(arg) || !Coder.SupportsScale(arg)
