						};

						_equaler = (Equaler<T>)(object)uriEq;

						_encoder = (Encoder<T>)(object)uriEnc;
						_decoder = (Decoder<T>)(object)uriDec;
						
						_saver = (Saver<T>)(object)uriSave;
						_loader = (Loader<T>)(object)uriLoad;

						_strEncoder = (StringEncoder<T>)(object)uriStrEnc;
						_strDecoder = (StringDecoder<T>)(object)uriStrDec;
					}
                    else if(typeof(T) == typeof(RefID))
                    {
                        Equaler<RefID> refEq = (a,b) => a == b;
                        
                        Encoder<RefID> refEnc = (v,bw) => bw.Write(v);
                        Decoder<RefID> refDec = br => br.ReadRefID();

                        Saver<RefID> refSave = v => v.Save();
                        Loader<RefID> refLoad = n => n.LoadRefID();

						StringEncoder<RefID> refStrEnc = v => v.ToString();
						StringDecoder<RefID> refStrDec = str => RefID.Parse(str);

						_equaler = (Equaler<T>)(object)refEq;

						_encoder = (Encoder<T>)(object)refEnc;
						_decoder = (Decoder<T>)(object)refDec;

